#include <iostream>
using namespace std;
void swaparray(int &x,int &y)
{
int temp;
temp=x;
x=y;
y=temp;
}
void readarray(int arr[],int n)
{
cout << "Enter the array elements:";
for(int i=0;i<n;i++)
{

cin >> arr[i];
}
}

void displayarray(int arr[],int n)
{
for(int i=0;i<n;i++)
{
cout << arr[i];
}
}
void sortarray(int arr[],int n)
{

for(int i=0;i<n-1;i++)
{
for(int j=0;j<n-i-1;j++)
{
if(arr[j]>arr[j+1])
swaparray(arr[j],arr[j+1]);

}
}
}

int main() {
int n;
int arr[5];
cout << "Enter no of elements:";
cin>>n;
readarray(arr,n);
cout << "The array elements are:";
displayarray(arr,n);
sortarray(arr,n);
cout << "\nThe sorted array is:";
displayarray(arr,n);
return 0;
}
